namespace Ideal

variable {R : Type*} [CommSemiring R]

/-- The principal ideals generated by an element of a submonoid `S` of `R` form a submonoid of
`Ideal R`. -/
def spanSubmonoid (S : Submonoid R) : Submonoid (Ideal R) where
  carrier := Set.range (fun x ↦ span {(x : R)} : S → Ideal R)
  mul_mem' := by
    rintro _ _ ⟨x, rfl⟩ ⟨y, rfl⟩
    exact ⟨x * y, by simp [span_singleton_mul_span_singleton]⟩
  one_mem' := ⟨1, by simp⟩

theorem mem_spanSubmonoid_iff (S : Submonoid R) {I : Ideal R} :
    I ∈ spanSubmonoid S ↔ ∃ x : S, I = span {(x : R)} := by
  rw [spanSubmonoid, ← Submonoid.mem_carrier]
  simp [Set.mem_range, eq_comm]

theorem span_singleton_mem_spanSubmonoid {S : Submonoid R} {a : R} (ha : a ∈ S) :
    span {a} ∈ spanSubmonoid S := ⟨⟨a, ha⟩, rfl⟩

end Ideal

namespace Submonoid.IsLocalizationMap

variable {M N : Type*} [CommMonoid M] [CommMonoid N] {S : Submonoid M}

protected theorem map_pow {F : Type*} [FunLike F M N] [MulHomClass F M N]
    {f : F} (hf : IsLocalizationMap S f) (a : M) (n : ℕ) : f (a ^ n) = f a ^ n := by
  induction n with
  | zero => simp [hf.map_one]
  | succ n hn => rw [pow_succ, pow_succ, map_mul, hn]

/-- A monoid with a localization map of a monoid with unique roots has unique roots. -/
theorem hasUniqueRoots {F : Type*} [FunLike F M N] [MulHomClass F M N] {f : F}
    (hf : IsLocalizationMap S f) [HasUniqueRoots M] : HasUniqueRoots N where
  pow_left_injective {n} hn x y hxy := by
    obtain ⟨⟨a₁, a₂⟩, ha⟩ := hf.surj x
    obtain ⟨⟨b₁, b₂⟩, hb⟩ := hf.surj y
    obtain ⟨c, hc⟩ : ∃ c : S, c * (a₁ ^ n * b₂ ^ n) = c * (b₁ ^ n * a₂ ^ n) :=
      hf.exists_of_eq <|
        by simp only [map_mul, hf.map_pow, ← ha, ← hb, mul_pow, hxy, mul_right_comm]
    suffices c * (a₁ * b₂) = c * (b₁ * a₂) by
      rw [← (hf.map_units a₂).mul_left_inj, ha, ← (hf.map_units b₂).mul_left_inj, mul_right_comm,
        hb, ← (hf.map_units c).mul_right_inj, ← map_mul, ← map_mul, ← map_mul, ← map_mul, this]
    refine pow_left_injective hn ?_
    obtain _ | n := n
    · simp
    · simp [mul_pow, pow_succ (c : M), mul_assoc, hc]

end Submonoid.IsLocalizationMap

namespace FractionalIdeal

open IsLocalization

variable {R : Type*} [CommRing R] {S : Submonoid R} {P : Type*} [CommRing P] [Algebra R P]
  [IsLocalization S P]

variable (S P) in
/-- If `S ≤ R⁰`, the monoid of fractional ideals of `R` with respect to `S` is the localization
of the monoid of ideals of `R` at the principal ideals generated by an element of `S`. -/
theorem isLocalizationMap_coeIdealHom (h : S ≤ nonZeroDivisors R) :
    Submonoid.IsLocalizationMap (Ideal.spanSubmonoid S) (coeIdealHom S P) where
  map_units := by
    rintro ⟨_, ⟨x, rfl⟩⟩
    simpa using IsUnit.map (spanSingleton S) (map_units P x)
  surj I :=
    ⟨⟨I.num, ⟨Ideal.span {(I.den : R)}, ⟨I.den, rfl⟩⟩⟩,
      by simpa [mul_comm] using den_mul_self_eq_num' S P I⟩
  exists_of_eq h_eq := ⟨1, by simpa using coeIdeal_injective' h h_eq⟩

instance [IsLocalization (nonZeroDivisors R) P]
    [HasUniqueRoots (Ideal R)] : HasUniqueRoots (FractionalIdeal (nonZeroDivisors R) P) :=
  (isLocalizationMap_coeIdealHom _ P le_rfl).hasUniqueRoots

end FractionalIdeal

