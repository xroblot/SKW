set_option linter.style.header false

/-!
# Gauss sums

This file holds the Gauss sums attached to the Teichmüller character and their properties, among
them the factorization of the ideal generated by a power of a Gauss sum in the cyclotomic field
`k = ℚ(μ_m)`, and deduces Stickelberger's theorem from it. Some statements carry no proof for the
moment; the earlier proofs are kept in `SKW.Stickelberger.rGaussSum`, `rvalGauss`,
`rFactorization` and `rStickelberger`, which are not part of the build. The auxiliary results that
have nothing to do with Gauss sums live in `SKW.Stickelberger.Misc`.
-/

@[expose] public section

noncomputable section

namespace Stickelberger

open Ideal NumberField IntermediateField IsDedekindDomain

variable {p : ℕ} (n : ℕ)

local notation3 "𝒑" => span {(p : ℤ)}

variable {L : Type*} [Field L] [NumberField L] {K F : IntermediateField ℚ L}

variable (P : Ideal (𝓞 K)) (𝓟 : Ideal (𝓞 L)) [P.HasTeichmullerLift n]

variable {ζ : 𝓞 F} (hζ : IsPrimitiveRoot ζ p)

attribute [local instance] ZMod.algebra

attribute [local instance] Ideal.Quotient.field

variable {P 𝓟} in
theorem cast_trace_eq_algebraMap_trace [P.LiesOver 𝒑] [CharP (𝓞 K ⧸ P) p]
    [Algebra (ℤ ⧸ 𝒑) (𝓞 L ⧸ 𝓟 ^ 2)] (x : 𝓞 K ⧸ P) :
    (Algebra.trace (ZMod p) (𝓞 K ⧸ P) x).cast =
      algebraMap _ (𝓞 L ⧸ 𝓟 ^ 2) (Algebra.trace (ℤ ⧸ 𝒑) (𝓞 K ⧸ P) x) := by
  rw [← ZMod.cast_trace_eq_trace (Int.quotientSpanNatEquivZMod p), ZMod.map_cast]

@[nolint defsWithUnderscore docBlame]
local instance [NeZero P] : Fintype (𝓞 K ⧸ P) := Fintype.ofFinite (𝓞 K ⧸ P)

section Teichmuller

variable {n P} [NeZero n] [IsCyclotomicExtension {n} ℚ K]

protected theorem teichmuller_ne_one (hn : n ≠ 1) :
    MulChar.teichmuller P n ≠ 1 :=
  MulChar.teichmuller_ne_one (IsCyclotomicExtension.zeta_spec n ℚ K).toInteger_isPrimitiveRoot hn

theorem teichmuller_ringHomComp_zpow_ne_one {a : ℤ}
    (ha : ¬ (n : ℤ) ∣ a) :
    (MulChar.teichmuller P n ^ a).ringHomComp (algebraMap (𝓞 K) (𝓞 L)) ≠ 1 := by
  rw [MulChar.ringHomComp_ne_one_iff]
  · rwa [ne_eq, MulChar.teichmuller_zpow_eq_one_iff] --  Int.dvd_neg]
    exact (IsCyclotomicExtension.zeta_spec n ℚ K).toInteger_isPrimitiveRoot
  · exact RingOfIntegers.algebraMap.injective K L

end Teichmuller

/-- Docstring. -/
protected def gaussSum [NeZero p] [P.LiesOver 𝒑] [CharP (𝓞 K ⧸ P) p] (a : ℤ) : 𝓞 L :=
  haveI : NeZero P := ⟨Ideal.ne_bot_of_liesOver_of_ne_bot (p := 𝒑) (by simpa using NeZero.ne p) _⟩
  gaussSum (((MulChar.teichmuller P n) ^ (- a)).ringHomComp (algebraMap (𝓞 K) (𝓞 L)))
    ((algebraMap (𝓞 F) (𝓞 L)).compAddChar (AddChar.traceChar (𝓞 K ⧸ P) hζ))

local notation3 "𝓖" => Stickelberger.gaussSum

/-- Docstring. -/
protected def jacobiSum [NeZero P] (a b : ℤ) : 𝓞 K :=
  jacobiSum (MulChar.teichmuller P n ^ (-a)) (MulChar.teichmuller P n ^ (-b))

local notation3 "𝓙" => Stickelberger.jacobiSum

section

-- The notation `𝒑` cannot be used in a `variable` command, since it refers to the variable `p`.
variable [NeZero p] [P.LiesOver (span {(p : ℤ)})] [CharP (𝓞 K ⧸ P) p]

variable {n P hζ}

theorem gaussSum_def (a : ℤ) :
    haveI : NeZero P := ⟨Ideal.ne_bot_of_liesOver_of_ne_bot (p := 𝒑) (by simpa using NeZero.ne p) _⟩
    𝓖 n P hζ a =
      gaussSum (((MulChar.teichmuller P n) ^ (- a)).ringHomComp (algebraMap (𝓞 K) (𝓞 L)))
      ((algebraMap (𝓞 F) (𝓞 L)).compAddChar (AddChar.traceChar (𝓞 K ⧸ P) hζ)) := rfl

theorem gaussSum_periodic {k : ℤ} (hk : (n : ℤ) ∣ k) (a : ℤ) :
    𝓖 n P hζ (a + k) = 𝓖 n P hζ a := by
  rw [gaussSum_def, gaussSum_def, neg_add, zpow_add,
    MulChar.teichmuller_zpow_eq_one_of_dvd (Int.dvd_neg.mpr hk), mul_one]

theorem gaussSum_congr {a b : ℤ} (h : a ≡ b [ZMOD n]) : 𝓖 n P hζ a = 𝓖 n P hζ b := by
  rw [← gaussSum_periodic h.dvd a, add_sub_cancel]

section

variable [NeZero n] [IsCyclotomicExtension {n} ℚ K]

theorem gaussSum_mem_span_zeta_sub_one (a : ℤ) (ha : ¬ (n : ℤ) ∣ a) :
    𝓖 n P hζ a ∈ Ideal.span {algebraMap (𝓞 F) (𝓞 L) ζ - 1} := by
  have : NeZero P := ⟨Ideal.ne_bot_of_liesOver_of_ne_bot (p := 𝒑) (by simpa using NeZero.ne p) _⟩
  simp_rw [gaussSum_def, gaussSum, AddChar.compAddChar_traceChar_algebraMap,
    ← Quotient.eq_zero_iff_mem, map_sum, map_mul,
    AddChar.mk_traceChar_apply_eq_one _ (mem_span_singleton_self _), mul_one, ← map_sum]
  rw [MulChar.sum_eq_zero_of_ne_one (teichmuller_ringHomComp_zpow_ne_one
    (by rwa [Int.dvd_neg])), map_zero]

variable (n P hζ) in
theorem gaussSum_mul_gaussSum [P.IsMaximal] {a b : ℤ} (h : ¬ (n : ℤ) ∣ a + b) :
    𝓖 n P hζ a * 𝓖 n P hζ b =
      𝓖 n P hζ (a + b) * algebraMap (𝓞 K) (𝓞 L) (𝓙 n P a b) := by
  rw [gaussSum_def, gaussSum_def, gaussSum_def, ← jacobiSum_mul_nontrivial,
    ← MulChar.ringHomComp_mul, ← zpow_add, neg_add, jacobiSum_ringHomComp,
    Stickelberger.jacobiSum]
  rw [← MulChar.ringHomComp_mul, ← zpow_add, ← neg_add]
  exact teichmuller_ringHomComp_zpow_ne_one (by rwa [Int.dvd_neg])

end

end

section

variable [hp : Fact p.Prime] [P.IsMaximal] [P.LiesOver (span {(p : ℤ)})] [CharP (𝓞 K ⧸ P) p]

variable {n P hζ}

theorem gaussSum_zero :
    𝓖 n P hζ 0 = -1 := by
  rw [gaussSum_def, neg_zero, zpow_zero, MulChar.ringHomComp_one, gaussSum_one_left]
  rw [AddChar.compAddChar_traceChar_algebraMap]
  exact AddChar.traceChar_ne_one _

theorem gaussSum_of_dvd (a : ℤ) (ha : (n : ℤ) ∣ a) :
    𝓖 n P hζ a = -1 := by
  rwa [← zero_add a, gaussSum_periodic, gaussSum_zero]

theorem gaussSum_frob (a : ℤ) :
    𝓖 n P hζ (p * a) = 𝓖 n P hζ a := by
  have : Fintype (ℤ ⧸ 𝒑) := Fintype.ofFinite _
  rw [gaussSum_def, gaussSum_def, gaussSum, gaussSum, eq_comm,
    ← ((FiniteField.frobeniusAlgEquiv (ℤ ⧸ 𝒑) _ p).bijective).sum_comp]
  refine Fintype.sum_congr _ _ fun _ ↦ ?_
  rw [FiniteField.frobeniusAlgEquiv_apply, Fintype.card_eq_nat_card, Int.card_ideal_quot,
    MonoidHom.coe_compAddChar, Function.comp_apply, Function.comp_apply,
    AddChar.traceChar_apply_pow, map_pow, ← MulChar.pow_apply' _ hp.out.ne_zero,
    MulChar.ringHomComp_pow, ← zpow_natCast, ← zpow_mul, neg_mul, mul_comm a]

section

variable [NeZero n] [IsCyclotomicExtension {n} ℚ K]

variable (n P hζ) in
theorem gaussSum_mul_gaussSum_neg {a : ℤ} (ha : ¬ (n : ℤ) ∣ a) :
    𝓖 n P hζ a * 𝓖 n P hζ (-a) =
      algebraMap (𝓞 K) (𝓞 L) (((MulChar.teichmuller P n) ^ (- a)) (- 1)) * p ^ P.inertiaDeg ℤ := by
  rw [gaussSum_def, gaussSum_def, ← mul_gaussSum_inv_eq_gaussSum,
    AddChar.compAddChar_traceChar_algebraMap, neg_neg, zpow_neg, ← MulChar.ringHomComp_inv,
    mul_right_comm, mul_assoc, gaussSum_mul_gaussSum_eq_card, Fintype.card_eq_nat_card,
    ← absNorm_eq_card, ← Ideal.pow_inertiaDeg p P, Nat.cast_pow, MulChar.ringHomComp_inv,
    MulChar.ringHomComp_apply]
  · exact teichmuller_ringHomComp_zpow_ne_one ha
  · apply AddChar.isPrimitive_traceChar _

variable (n P hζ) in
omit [P.IsMaximal] in
theorem not_isUnit_gaussSum (a : ℤ) (ha : ¬ (n : ℤ) ∣ a) :
    ¬ IsUnit (𝓖 n P hζ a) := by
  have h : span {(algebraMap (𝓞 F) (𝓞 L)) (ζ - 1)} ≠ ⊤ := by
    rw [ne_eq, span_singleton_eq_top, isUnit_map_iff, hζ.isUnit_sub_one_iff hp.out.one_lt, not_not]
    exact ⟨p, 1, hp.out.prime, zero_lt_one, by rw [pow_one]⟩
  contrapose h
  rw [map_sub, map_one]
  exact Ideal.eq_top_of_isUnit_mem _ (gaussSum_mem_span_zeta_sub_one a ha) h

variable (n P hζ) in
theorem norm_gaussSum (a : ℤ) (ha : ¬ (n : ℤ) ∣ a) :
    ∃ k, 1 ≤ k ∧ (Algebra.norm ℤ (𝓖 n P hζ a)).natAbs = p ^ k := by
  have h := congr_arg (Int.natAbs <| Algebra.norm ℤ ·) <| gaussSum_mul_gaussSum_neg n P hζ ha
  rw [map_mul, map_mul, Int.natAbs_mul, Int.natAbs_mul, zpow_neg,
    ← map_natCast (algebraMap ℤ (𝓞 L)), map_pow,
    Algebra.norm_algebraMap_of_basis (NumberField.RingOfIntegers.basis L), ← pow_mul,
    isUnit_iff_natAbs_norm.mp (RingHom.isUnit_map (algebraMap (𝓞 K) (𝓞 L)) _), one_mul,
    Int.natAbs_pow, Int.natAbs_natCast] at h
  · obtain ⟨k, -, hk⟩ := (Nat.dvd_prime_pow hp.out).mp (Dvd.intro _ h)
    refine ⟨k, ?_, hk⟩
    by_contra! h
    refine not_isUnit_gaussSum n P hζ a ha ?_
    rw [isUnit_iff_natAbs_norm, hk,  Nat.lt_one_iff.mp h, pow_zero]
  · rw [MulChar.inv_apply', inv_neg, inv_one]
    exact isUnit_neg_one.map _

theorem gaussSum_ne_zero (a : ℤ) :
    𝓖 n P hζ a ≠ 0 := by
  by_cases ha : (n : ℤ) ∣ a
  · grind [gaussSum_of_dvd]
  · obtain ⟨k, _, hk⟩ := norm_gaussSum n P hζ a ha
    contrapose! hk
    rw [hk, Algebra.norm_zero, Int.natAbs_zero, ne_comm, pow_ne_zero_iff (by grind)]
    exact hp.out.ne_zero

variable (hζ) in
include hζ in
theorem jacobiSum_ne_zero (a b : ℤ) (ha : ¬ (n : ℤ) ∣ (a + b)) :
    𝓙 n P a b ≠ 0 := by
  by_contra h
  have := gaussSum_mul_gaussSum n P hζ ha
  grind [mul_zero, mul_eq_zero, gaussSum_ne_zero]

end

end

section IsCycloF

variable [hp : Fact p.Prime] [IsCyclotomicExtension {p} ℚ F]
    [P.LiesOver (span {(p : ℤ)})]

include hζ in
theorem zeta_sub_one_mem [𝓟.IsPrime] [𝓟.LiesOver 𝒑] : algebraMap (𝓞 F) (𝓞 L) ζ - 1 ∈ 𝓟 := by
  rw [← map_one (f := algebraMap (𝓞 F) (𝓞 L)), ← map_sub, ← mem_comap,
    ← Ideal.under_def, IsCyclotomicExtension.Rat.eq_span_zeta_sub_one_of_liesOver' p F
      (IsPrimitiveRoot.coe_submonoidClass_iff.mpr hζ) (under (𝓞 F) 𝓟)]
  exact Submodule.mem_span_singleton_self _

variable {n P 𝓟 hζ}

theorem gaussSum_mem [CharP (𝓞 K ⧸ P) p] [NeZero n] [IsCyclotomicExtension {n} ℚ K]
    [𝓟.IsPrime] [𝓟.LiesOver 𝒑] (a : ℤ) (ha : ¬ (n : ℤ) ∣ a) :
    𝓖 n P hζ a ∈ 𝓟 :=
  (span_singleton_le_iff_mem 𝓟).mpr (zeta_sub_one_mem 𝓟 hζ) <|
    gaussSum_mem_span_zeta_sub_one a ha

variable [P.IsMaximal]

omit [P.HasTeichmullerLift n] in
private theorem sum_teichmuller_inv_mul_cast_trace_aux (i : ℕ) :
    ∑ a : 𝓞 K ⧸ P, a⁻¹ * a ^ p ^ i = if P.inertiaDeg ℤ ∣ i then -1 else 0  := by
  rw [← Nat.succ_pred_eq_of_pos (NeZero.pos (p ^ i)), FiniteField.sum_inv_mul_pow_succ]
  obtain rfl | hi := Nat.eq_zero_or_pos i
  · simp
  · rw [Fintype.card_eq_nat_card, ← absNorm_eq_card, ← Ideal.pow_inertiaDeg p P,
      Nat.pred_eq_sub_one,
      if_congr (Nat.pow_sub_one_dvd_pow_sub_one_iff hp.out.one_lt) rfl rfl]

private theorem sum_teichmuller_inv_mul_cast_trace [CharP (𝓞 K ⧸ P) p] [(𝓟 ^ 2).LiesOver P] :
    ∑ x : 𝓞 K ⧸ P, algebraMap (𝓞 K) (𝓞 L ⧸ 𝓟 ^ 2) ((MulChar.teichmuller P n)⁻¹ x) *
      (Algebra.trace (ZMod p) (𝓞 K ⧸ P) x).cast = - 1 := by
  classical
  have : (𝓟 ^ 2).LiesOver 𝒑 := LiesOver.trans (𝓟 ^ 2) P 𝒑
  simp_rw [cast_trace_eq_algebraMap_trace,
    IsScalarTower.algebraMap_apply (ℤ ⧸ 𝒑) (𝓞 K ⧸ P) (𝓞 L ⧸ 𝓟 ^ 2),
    FiniteField.algebraMap_trace_eq_sum_pow (ℤ ⧸ 𝒑) (𝓞 K ⧸ P), map_sum, Finset.mul_sum,
    IsScalarTower.algebraMap_apply (𝓞 K) (𝓞 K ⧸ P) (𝓞 L ⧸ 𝓟 ^ 2), MulChar.inv_apply',
    Quotient.algebraMap_eq, MulChar.mk_teichmuller_apply]
  rw [Finset.sum_comm]
  simp_rw [← map_mul, ← map_sum, Int.card_ideal_quot, sum_teichmuller_inv_mul_cast_trace_aux]
  rw [inertiaDeg_eq_of_isMaximal 𝒑 P, ← Nat.succ_pred_eq_of_pos (n := Module.finrank _ _)
    Module.finrank_pos, Finset.sum_range_succ', Finset.sum_eq_zero, zero_add,
    ite_eq_left (Nat.dvd_zero _), map_neg, map_one]
  intro _ _
  rw [ite_eq_right]
  exact (Nat.le_of_dvd (Nat.succ_pos _)).mt (by grind)

theorem mk_sq_gaussSum_eq [CharP (𝓞 K ⧸ P) p] [IsCyclotomicExtension {n} ℚ K] [𝓟.IsPrime]
    [𝓟.LiesOver P] (hn : 1 < n)
    (h𝓟 : 2 ≤ 𝓟.ramificationIdx (𝓞 K)) :
    Ideal.Quotient.mk (𝓟 ^ 2) (𝓖 n P hζ 1) = -(algebraMap (𝓞 F) (𝓞 L) ζ - 1 :) := by
  classical
  have : NeZero n := ⟨Nat.ne_zero_of_lt hn⟩
  have : NeZero P := ⟨Ideal.ne_bot_of_liesOver_of_ne_bot (p := 𝒑) (by simpa using NeZero.ne p) _⟩
  have : 𝓟.LiesOver 𝒑 := LiesOver.trans 𝓟 P 𝒑
  have : (𝓟 ^ 2).LiesOver P := by
    refine pow_liesOver_of_liesOver P 𝓟 ?_
    rw [Ideal.ramificationIdx'_eq_ramificationIdx _ _ (NeZero.ne P)]
    exact h𝓟
  have : (𝓟 ^ 2).LiesOver 𝒑 := LiesOver.trans (𝓟 ^ 2) P 𝒑
  have hζ₀ := hζ.map_of_injective (FaithfulSMul.algebraMap_injective (𝓞 F) (𝓞 L))
  have h𝓟 := zeta_sub_one_mem 𝓟 hζ
  have h : (MulChar.teichmuller P n)⁻¹ ≠ 1 :=
    inv_ne_one.mpr <| MulChar.teichmuller_ne_one
      (IsCyclotomicExtension.zeta_spec n ℚ K).toInteger_isPrimitiveRoot hn.ne'
  rw [gaussSum_def, gaussSum]
  simp_rw [zpow_neg, zpow_one, MulChar.ringHomComp_apply, map_sum, map_mul,
    AddChar.compAddChar_traceChar_algebraMap,
    AddChar.mk_traceChar_apply_eq_one_add_smul hζ₀ h𝓟, mul_add, mul_one,
    Finset.sum_add_distrib, ← map_sum, MulChar.sum_eq_zero_of_ne_one h, map_zero, zero_add,
    Algebra.smul_def, ← mul_assoc, ← Finset.sum_mul, Quotient.mk_algebraMap, eq_natCast,
    ZMod.natCast_val, sum_teichmuller_inv_mul_cast_trace, map_neg, map_sub,
    Quotient.mk_algebraMap, map_one, neg_mul, one_mul]

end IsCycloF
section Galois

variable (p) [NeZero p] [NeZero n] [hn : Fact (n.Coprime p)] [IsCyclotomicExtension {p * n} ℚ L]

theorem smul_traceChar [CharP (𝓞 K ⧸ P) p] (σ : Gal(L/F)) (x : 𝓞 K ⧸ P) :
    σ • (algebraMap (𝓞 F) (𝓞 L)).compAddChar (AddChar.traceChar (𝓞 K ⧸ P) hζ) x =
      (algebraMap (𝓞 F) (𝓞 L)).compAddChar (AddChar.traceChar (𝓞 K ⧸ P) hζ) x := by
  rw [AddChar.compAddChar_traceChar_algebraMap, smul_eq_galRestrict_apply (𝓞 F),
    AddChar.map_traceChar_apply_eq_mulShift _ _ 1, Nat.cast_one, AddChar.mulShift_one]
  rw [AlgEquiv.commutes, pow_one]

theorem smul_traceChar' [CharP (𝓞 K ⧸ P) p] (τ : Gal(L/K)) {e : ℕ}
    (hτ : τ • algebraMap (𝓞 F) (𝓞 L) ζ = algebraMap (𝓞 F) (𝓞 L) ζ ^ e) (x : 𝓞 K ⧸ P) :
    τ • (algebraMap (𝓞 F) (𝓞 L)).compAddChar (AddChar.traceChar (𝓞 K ⧸ P) hζ) x
       = ((algebraMap (𝓞 F) (𝓞 L)).compAddChar (AddChar.traceChar (𝓞 K ⧸ P) hζ)).mulShift e x := by
  rw [AddChar.compAddChar_traceChar_algebraMap, smul_eq_galRestrict_apply (𝓞 K),
    AddChar.map_traceChar_apply_eq_mulShift _ _ e (by rwa [← smul_eq_galRestrict_apply])]

variable [IsCyclotomicExtension {p} ℚ F] [IsCyclotomicExtension {n} ℚ K] (K F)

/-- The isomorphism between `Gal(L/F)` and `(ZMod n)ˣ` given by restriction to `K`. -/
def galFEquiv : Gal(L/F) ≃* (ZMod n)ˣ :=
  haveI := IsCyclotomicExtension.isAbelianGalois {p * n} ℚ L
  MulEquiv.ofBijective (restrictRestrictAlgEquivMapHom ℚ K F L)
    ⟨restrictRestrictAlgEquivMapHom_injective _ _ <|
      have : IsCyclotomicExtension {p * n} ℚ (⊤ : IntermediateField ℚ L) :=
        .equiv _ _ _ topEquiv.symm
      have : IsCyclotomicExtension {p * n} ℚ ↑(K ⊔ F) := by
        rw [mul_comm, ← Nat.Coprime.lcm_eq_mul hn.out]
        exact isCyclotomicExtension_lcm_sup ℚ L n p K F
      isCyclotomicExtension_eq {p * n} ℚ L _ _,
    restrictRestrictAlgEquivMapHom_surjective _ _ <|
      LinearDisjoint.inf_eq_bot <|
        IsCyclotomicExtension.Rat.linearDisjoint_ofCoprime n p K F hn.out⟩ |>.trans <|
   IsCyclotomicExtension.Rat.galEquivZMod n K

theorem galFEquiv_eq [Normal ℚ K] (σ : Gal(L/F)) :
    galFEquiv p n K F σ =
      IsCyclotomicExtension.Rat.galEquivZMod n K ((σ.restrictScalars ℚ).restrictNormal K) :=
  rfl

variable {n K F P hζ}

theorem _root_.IsPrimitiveRoot.galLFEquiv_apply (σ : Gal(L/F)) {η : K} (hη : IsPrimitiveRoot η n) :
    σ (algebraMap K L η) = (algebraMap K L η) ^ (galFEquiv p n K F σ).val.val := by
  have : Normal ℚ K := (IsCyclotomicExtension.isGalois {n} ℚ K).to_normal
  rw [galFEquiv_eq, ← map_pow,
    ← IsCyclotomicExtension.Rat.galEquivZMod_apply_of_pow_eq _ _ _ hη.pow_eq_one,
    AlgEquiv.restrictNormal_commutes, AlgEquiv.coe_restrictScalars]

theorem smul_teichmuller (σ : Gal(L/F)) (a : ℤ) (x : 𝓞 K ⧸ P) :
    σ • (MulChar.teichmuller P n ^ (-a)).ringHomComp (algebraMap (𝓞 K) (𝓞 L)) x =
      (MulChar.teichmuller P n ^ (-(a * (galFEquiv p n K F σ).val.val))).ringHomComp
        (algebraMap (𝓞 K) (𝓞 L)) x := by
  let η : 𝓞 K := (IsCyclotomicExtension.zeta_spec n ℚ K).toInteger
  have hη := (IsCyclotomicExtension.zeta_spec n ℚ K).toInteger_isPrimitiveRoot
  rw [smul_eq_galRestrict_apply (𝓞 F), MulChar.map_ringHomComp_teichmuller_zpow_apply _ _
    (galFEquiv p n K F σ).val.val hη, neg_mul]
  rw [← smul_eq_galRestrict_apply]
  apply RingOfIntegers.coe_injective
  rw [algebraMap.smul', map_pow, ← IsScalarTower.algebraMap_apply, AlgEquiv.smul_def,
    IsScalarTower.algebraMap_apply (𝓞 K) K L]
  exact (hη.map_of_injective <| RingOfIntegers.coe_injective).galLFEquiv_apply p σ

theorem smul_teichmuller' (σ : Gal(L/K)) (a : ℤ) (x : 𝓞 K ⧸ P) :
    σ • (MulChar.teichmuller P n ^ (-a)).ringHomComp (algebraMap (𝓞 K) (𝓞 L)) x =
      (MulChar.teichmuller P n ^ (-a)).ringHomComp (algebraMap (𝓞 K) (𝓞 L)) x := by
  let η : 𝓞 K := (IsCyclotomicExtension.zeta_spec n ℚ K).toInteger
  have hη := (IsCyclotomicExtension.zeta_spec n ℚ K).toInteger_isPrimitiveRoot
  rw [smul_eq_galRestrict_apply (𝓞 K), MulChar.map_ringHomComp_teichmuller_zpow_apply _ _
    1 hη (by simp), neg_mul, Nat.cast_one, mul_one]

variable {p} in
theorem gal_gaussSum_eq_gaussSum [P.LiesOver 𝒑] [CharP (𝓞 K ⧸ P) p] (σ : Gal(L/F)) (a : ℤ) :
    σ • 𝓖 n P hζ a = 𝓖 n P hζ (a * (galFEquiv p n  K F σ).val.val) := by
  have : NeZero P := ⟨Ideal.ne_bot_of_liesOver_of_ne_bot (p := 𝒑) (by simpa using NeZero.ne p) _⟩
  rw [gaussSum_def, gaussSum_def, gaussSum, gaussSum, Finset.smul_sum]
  exact Finset.sum_congr rfl fun _ _ ↦ by rw [smul_mul', smul_traceChar, smul_teichmuller p]

omit [Fact (n.Coprime p)] [IsCyclotomicExtension {p * n} ℚ L] [IsCyclotomicExtension {p} ℚ F] in
theorem gal_gaussSum_eq_mul_gaussSum [CharP (𝓞 K ⧸ P) p] [P.LiesOver 𝒑] (τ : Gal(L/K))
    (e : (ZMod p)ˣ)
    (hτ : τ • algebraMap (𝓞 F) (𝓞 L) ζ = algebraMap (𝓞 F) (𝓞 L) ζ ^ e.val.val) (a : ℤ) :
    τ • 𝓖 n P hζ a =
      (((MulChar.teichmuller P n) ^ (- a)).ringHomComp (algebraMap (𝓞 K) (𝓞 L)))⁻¹
      (e.map (ZMod.castHom dvd_rfl (𝓞 K ⧸ P))).val * 𝓖 n P hζ a := by
  have : NeZero P := ⟨Ideal.ne_bot_of_liesOver_of_ne_bot (p := 𝒑) (by simpa using NeZero.ne p) _⟩
  rw [gaussSum_def, ← gaussSum_mulShift_eq, gaussSum, gaussSum, Finset.smul_sum]
  refine Finset.sum_congr rfl fun _ _ ↦  ?_
  rw [smul_mul', smul_teichmuller', smul_traceChar' p P hζ _ hτ]
  simp

end Galois

section FiniteMultiplicity

variable {n P 𝓟 hζ}

variable [Fact p.Prime] [P.IsMaximal] [P.LiesOver (span {(p : ℤ)})] [CharP (𝓞 K ⧸ P) p]
  [𝓟.IsMaximal] [NeZero n] [IsCyclotomicExtension {n} ℚ K]

theorem finiteMultiplicity_gaussSum {a : ℤ} :
    FiniteMultiplicity 𝓟 (span {𝓖 n P hζ a}) :=
  FiniteMultiplicity.of_prime_left (prime_of_maximal 𝓟) <| by simpa using gaussSum_ne_zero _

variable (hζ)

include hζ in
theorem finiteMultiplicity_jacobiSum {a b : ℤ} (h : ¬ (n : ℤ) ∣ a + b) :
    FiniteMultiplicity 𝓟 (span {algebraMap (𝓞 K) (𝓞 L) (𝓙 n P a b)}) :=
  FiniteMultiplicity.of_prime_left (prime_of_maximal 𝓟) <| by
    simpa using jacobiSum_ne_zero hζ a b h

end FiniteMultiplicity
section ValGauss

variable [NeZero p] [P.LiesOver (span {(p : ℤ)})] [CharP (𝓞 K ⧸ P) p]

/-- The multiplicity of the prime `𝓟` of `𝓞 L` in the ideal generated by the Gauss sum
`𝓖 n P hζ a`. -/
def valGauss (a : ℤ) : ℕ := multiplicity 𝓟 (span {(𝓖 n P hζ a : 𝓞 L)})

variable {n P 𝓟 hζ}

theorem valGauss_periodic (a b : ℤ) (h : a ≡ b [ZMOD (n : ℕ)]) :
    valGauss n P 𝓟 hζ a = valGauss n P 𝓟 hζ b := by
  obtain ⟨k, rfl⟩ := Int.modEq_iff_add_fac.mp h
  rw [valGauss, valGauss, gaussSum_periodic (dvd_mul_right _ _)]

end ValGauss

section ValGaussGalois

variable [NeZero p] [NeZero n] [Fact (n.Coprime p)] [IsCyclotomicExtension {p * n} ℚ L]
    [IsCyclotomicExtension {p} ℚ F] [IsCyclotomicExtension {n} ℚ K]
    [P.LiesOver (span {(p : ℤ)})] [CharP (𝓞 K ⧸ P) p]

variable {n P 𝓟 hζ}

open scoped Pointwise in
theorem valGauss_smul (σ : Gal(L/F)) (a : ℤ) :
    valGauss n P (σ • 𝓟) hζ a = valGauss n P 𝓟 hζ (a * (galFEquiv p n K F σ⁻¹).val.val) := by
  rw [valGauss, valGauss, ← gal_gaussSum_eq_gaussSum, ← Set.smul_set_singleton,
    ← Ideal.smul_closure, ← multiplicity_smul σ⁻¹, inv_smul_smul]

end ValGaussGalois

section ValGaussPrime

variable [Fact p.Prime] [P.IsMaximal] [P.LiesOver (span {(p : ℤ)})] [CharP (𝓞 K ⧸ P) p]

variable {n P 𝓟 hζ}

theorem valGauss_eq_zero {a : ℤ} (ha : (n : ℤ) ∣ a) :
    valGauss n P 𝓟 hζ a = 0 := by
  simp [valGauss, gaussSum_of_dvd _ ha]

theorem valGauss_zero :
    valGauss n P 𝓟 hζ 0 = 0 :=
  valGauss_eq_zero (Int.dvd_zero _)

section

variable [𝓟.IsMaximal] [NeZero n] [IsCyclotomicExtension {n} ℚ K]

theorem valGauss_add_valGauss {a b : ℤ} (h : ¬ (n : ℤ) ∣ a + b) :
    valGauss n P 𝓟 hζ a + valGauss n P 𝓟 hζ b = valGauss n P 𝓟 hζ (a + b) +
       multiplicity 𝓟 (span {algebraMap (𝓞 K) (𝓞 L) (𝓙 n P a b)}) := by
  rw [valGauss, valGauss, valGauss, ← multiplicity_mul (prime_of_maximal 𝓟),
      span_singleton_mul_span_singleton, gaussSum_mul_gaussSum _ _ _ h,
      ← span_singleton_mul_span_singleton, multiplicity_mul (prime_of_maximal 𝓟)]
  · exact (prime_of_maximal 𝓟).finiteMultiplicity_mul finiteMultiplicity_gaussSum
      (finiteMultiplicity_jacobiSum hζ h)
  · exact (prime_of_maximal 𝓟).finiteMultiplicity_mul finiteMultiplicity_gaussSum
      finiteMultiplicity_gaussSum

theorem valGauss_subadditive (a b : ℤ) :
    valGauss n P 𝓟 hζ (a + b) ≤ valGauss n P 𝓟 hζ a + valGauss n P 𝓟 hζ b := by
  by_cases h : (n : ℤ) ∣ a + b
  · rw [valGauss_eq_zero h]
    exact zero_le
  · rw [valGauss_add_valGauss h]
    exact Nat.le_add_right _ _

theorem valGauss_add_valGauss_neg_self [𝓟.LiesOver 𝒑] {a : ℤ}
    (ha : ¬ (n : ℤ) ∣ a) :
    valGauss n P 𝓟 hζ a + valGauss n P 𝓟 hζ (-a) = P.inertiaDeg ℤ * 𝓟.ramificationIdx ℤ := by
  rw [valGauss, valGauss, ← multiplicity_mul (prime_of_maximal 𝓟),
    span_singleton_mul_span_singleton, gaussSum_mul_gaussSum_neg _ _ _ ha,
    ← span_singleton_mul_span_singleton, multiplicity_mul (prime_of_maximal 𝓟),
    multiplicity_of_isUnit_right, zero_add, ← span_singleton_pow,
    multiplicity_pow (prime_of_maximal 𝓟), ← map_natCast (algebraMap ℤ (𝓞 L)),
    ← Set.image_singleton, ← map_span, ← IsDedekindDomain.ramificationIdx_eq_multiplicity]
  · exact map_ne_bot_of_ne_bot <| by simpa using NeZero.ne p
  · simp [MulChar.inv_apply']
  · rw [span_singleton_eq_top.mpr (by simp), top_mul]
    exact FiniteMultiplicity.of_prime_left (prime_of_maximal 𝓟) (by simp [NeZero.ne p])
  · exact (prime_of_maximal 𝓟).finiteMultiplicity_mul finiteMultiplicity_gaussSum
      finiteMultiplicity_gaussSum

theorem valGauss_add_valGauss_sub_self [𝓟.LiesOver 𝒑] {k : ℤ} (hk : (n : ℤ) ∣ k)
    (a : ℤ) :
    valGauss n P 𝓟 hζ a + valGauss n P 𝓟 hζ (k - a) =
      if (n : ℤ) ∣ a then 0 else P.inertiaDeg ℤ *  𝓟.ramificationIdx ℤ := by
  split_ifs with h
  · rw [valGauss_eq_zero h, valGauss_eq_zero (dvd_sub hk h), zero_add]
  · rw [valGauss_periodic (k - a) (-a), valGauss_add_valGauss_neg_self h]
    rwa [Int.modEq_iff_dvd, sub_sub_eq_add_sub, neg_add_cancel, zero_sub, Int.dvd_neg]

end

section

variable [NeZero n] [IsCyclotomicExtension {n} ℚ K]

theorem valGauss_eq_zero_of_not_liesOver [𝓟.IsMaximal] (h𝓟 : ¬ 𝓟.LiesOver 𝒑) (a : ℤ) :
    valGauss n P 𝓟 hζ a = 0 := by
  by_cases ha : (n : ℤ) ∣ a
  · rw [valGauss_eq_zero ha]
  · contrapose! h𝓟
    obtain ⟨k, hk₁, hk₂⟩ := norm_gaussSum n P hζ a ha
    refine liesOver_of_absNorm_dvd_prime_pow 𝓟 (k := k) ?_
    rw [← hk₂, ← Int.natCast_dvd]
    refine Ideal.absNorm_dvd_norm_of_mem ?_
    rwa [valGauss, multiplicity_ne_zero finiteMultiplicity_gaussSum, dvd_span_singleton] at h𝓟

end

end ValGaussPrime

section ValGaussOne

variable [Fact p.Prime] [IsCyclotomicExtension {p} ℚ F] [P.IsMaximal]
    [P.LiesOver (span {(p : ℤ)})] [CharP (𝓞 K ⧸ P) p]
    [𝓟.IsMaximal] [𝓟.LiesOver P] [IsCyclotomicExtension {n} ℚ K]

variable {n P 𝓟 hζ}

theorem valGauss_one (hn : 1 < n) (h𝓟 : 2 ≤ 𝓟.ramificationIdx (𝓞 K))
    (hζ𝓟 : algebraMap (𝓞 F) (𝓞 L) ζ - 1 ∉ 𝓟 ^ 2) :
    valGauss n P 𝓟 hζ 1 = 1 := by
  have : NeZero n := ⟨by lia⟩
  have : 𝓟.LiesOver 𝒑 := LiesOver.trans 𝓟 P _
  refine finiteMultiplicity_gaussSum.multiplicity_eq_iff.mpr ⟨?_, ?_⟩
  · rw [pow_one, dvd_span_singleton]
    apply gaussSum_mem
    rw [Int.natCast_dvd_ofNat, Nat.dvd_one]
    exact hn.ne'
  · rwa [dvd_span_singleton, ← Quotient.eq_zero_iff_mem, mk_sq_gaussSum_eq hn, map_neg,
      neg_eq_zero, Quotient.eq_zero_iff_mem]

theorem valGauss_le_self (hn : 1 < n) (h𝓟 : 2 ≤ 𝓟.ramificationIdx (𝓞 K))
    (hζ𝓟 : algebraMap (𝓞 F) (𝓞 L) ζ - 1 ∉ 𝓟 ^ 2) (a : ℕ) :
    valGauss n P 𝓟 hζ a ≤ a := by
  have : NeZero n := ⟨by lia⟩
  induction a with
  | zero => rw [Nat.cast_zero, valGauss_zero]
  | succ a ha =>
    rw [Nat.cast_add, Nat.cast_one]
    refine (valGauss_subadditive a 1).trans ?_
    gcongr
    rw [valGauss_one hn h𝓟 hζ𝓟]

end ValGaussOne

section ValGaussDigits

variable [Fact p.Prime] [IsCyclotomicExtension {p} ℚ F] [P.IsMaximal]
    [P.LiesOver (span {(p : ℤ)})] [CharP (𝓞 K ⧸ P) p] [𝓟.IsMaximal] [𝓟.LiesOver P] [NeZero n]
    [IsCyclotomicExtension {n} ℚ K]

variable {n P 𝓟 hζ}

open Finset

omit [IsCyclotomicExtension {p} ℚ F] in
theorem two_mul_sum_valGauss :
    2 * ∑ a ∈ range n, valGauss n P 𝓟 hζ a =
      (n - 1) * (P.inertiaDeg ℤ * 𝓟.ramificationIdx ℤ) := by
  have : 𝓟.LiesOver 𝒑 := LiesOver.trans 𝓟 P _
  calc
    _ = 2 * ∑ a ∈ range (n + 1), valGauss n P 𝓟 hζ a := by
      rw [Finset.sum_range_succ, valGauss_eq_zero dvd_rfl, add_zero]
    _ = ∑ a ∈ range (n + 1), valGauss n P 𝓟 hζ a +
          ∑ a ∈ range (n + 1), valGauss n P 𝓟 hζ (n + 1 - 1 - a : ℕ) := by
      rw [Finset.sum_range_reflect (valGauss n P 𝓟 hζ ·), two_mul]
    _ = ∑ a ∈ range (n - 1 + 1 + 1), (valGauss n P 𝓟 hζ a + valGauss n P 𝓟 hζ (n - a)) := by
      rw [Nat.sub_add_cancel (NeZero.pos n), add_tsub_cancel_right, Finset.sum_add_distrib,
        add_right_inj]
      exact Finset.sum_congr rfl fun i hi ↦ by rw [Nat.cast_sub (mem_range_succ_iff.mp hi)]
    _ = ∑ x ∈ range (n - 1), if n ∣ x + 1 then 0 else P.inertiaDeg ℤ * 𝓟.ramificationIdx ℤ := by
      simp_rw [valGauss_add_valGauss_sub_self dvd_rfl]
      rw [Finset.sum_range_succ', Finset.sum_range_succ, Nat.cast_zero, ite_eq_left (dvd_zero _),
        Nat.sub_add_cancel (NeZero.pos n), ite_eq_left dvd_rfl, add_zero, add_zero]
      simp_rw [Int.natCast_dvd_natCast]
    _ = ∑ k ∈ range (n - 1), P.inertiaDeg ℤ * 𝓟.ramificationIdx ℤ := by
      refine Finset.sum_congr rfl fun i hi ↦ ite_eq_right ?_
      exact (Nat.le_of_dvd (Nat.succ_pos i)).mt (by grind : ¬ n ≤ i + 1)
    _ = (n - 1) * (P.inertiaDeg ℤ * 𝓟.ramificationIdx ℤ) := by simp

theorem valGauss_ofDigits_le_sum (hn : 1 < n) (h𝓟 : 2 ≤ 𝓟.ramificationIdx (𝓞 K))
    (hζ𝓟 : algebraMap (𝓞 F) (𝓞 L) ζ - 1 ∉ 𝓟 ^ 2) (D : List ℕ) :
    valGauss n P 𝓟 hζ (Nat.ofDigits p D : ℕ) ≤ D.sum := by
  induction D with
  | nil => simpa [Nat.ofDigits] using valGauss_zero
  | cons head tail ih =>
    rw [List.sum_cons, Nat.ofDigits_cons, Nat.cast_add]
    refine (valGauss_subadditive _ _).trans ?_
    gcongr
    · exact valGauss_le_self hn h𝓟 hζ𝓟 _
    · rwa [Nat.cast_mul, valGauss, gaussSum_frob]

theorem valGauss_le_sum_digits (hn : 1 < n) (h𝓟 : 2 ≤ 𝓟.ramificationIdx (𝓞 K))
    (hζ𝓟 : algebraMap (𝓞 F) (𝓞 L) ζ - 1 ∉ 𝓟 ^ 2) (a : ℕ) :
    valGauss n P 𝓟 hζ a ≤ (Nat.digits p a).sum := by
  conv_lhs => rw [← Nat.ofDigits_digits p a]
  exact valGauss_ofDigits_le_sum hn h𝓟 hζ𝓟 _

end ValGaussDigits

theorem not_dvd_pow_self_sub_one (p f : ℕ) [hp : Fact (p.Prime)] [NeZero (p ^ f - 1)] :
    ¬ p ∣ p ^ f - 1 := by
  rw [Nat.dvd_sub_iff_right NeZero.one_le (p.div_pow_of_pos f _), Nat.dvd_one]
  · exact hp.out.ne_one
  · by_contra! h
    aesop

/-- A prime of `𝓞 L` above `p` has ramification index `p - 1` over `p`. -/
theorem ramificationIdx_eq_p_sub_one (f : ℕ) [hp : Fact p.Prime] [NeZero (p ^ f - 1)]
    [IsCyclotomicExtension {p * (p ^ f - 1)} ℚ L] (𝓠 : Ideal (𝓞 L)) [𝓠.IsPrime] [𝓠.LiesOver 𝒑] :
    𝓠.ramificationIdx ℤ = p - 1 := by
  simpa using @IsCyclotomicExtension.Rat.ramificationIdx_eq (p * (p ^ f - 1)) (p ^ f - 1) p 0 hp L
    _ _ 𝓠 _ _ _ (by ring) (not_dvd_pow_self_sub_one p f)

/-- A prime of `𝓞 L` above a prime `𝔮` of `𝓞 k` above `p` has ramification index `p - 1`
over `𝔮`. -/
theorem ramificationIdx_eq_sub_one {f m d : ℕ} [hp : Fact p.Prime] [NeZero f] [NeZero m]
    [IsCyclotomicExtension {p * (p ^ f - 1)} ℚ L] {k : IntermediateField ℚ L}
    [IsCyclotomicExtension {m} ℚ k] (hmd : p ^ f - 1 = m * d) (𝔮 : Ideal (𝓞 k)) [𝔮.IsMaximal]
    [𝔮.LiesOver 𝒑] {𝓠 : Ideal (𝓞 L)} [𝓠.IsPrime] [𝓠.LiesOver 𝔮] :
    𝓠.ramificationIdx (𝓞 k) = p - 1 := by
  have : NeZero (p ^ f - 1) := ⟨Nat.sub_ne_zero_of_lt (Nat.one_lt_pow (NeZero.ne f) hp.out.one_lt)⟩
  have : 𝓠.LiesOver 𝒑 := LiesOver.trans 𝓠 𝔮 𝒑
  have hm : ¬ p ∣ m := fun h ↦ not_dvd_pow_self_sub_one p f (h.trans ⟨d, hmd⟩)
  have h𝓠 : 𝓠.ramificationIdx ℤ = p - 1 := ramificationIdx_eq_p_sub_one f 𝓠
  have tower := ramificationIdx_tower (R := ℤ) 𝔮 𝓠
  rw [h𝓠,
    IsCyclotomicExtension.Rat.ramificationIdx_eq_of_not_dvd p k 𝔮 hm, one_mul] at tower
  exact tower.symm

/-- A prime of `𝓞 L` above `p` is unramified over the prime of `𝓞 F` below it. -/
theorem ramificationIdx_under_eq_one (p f : ℕ) [hp : Fact p.Prime] [NeZero (p ^ f - 1)]
    [IsCyclotomicExtension {p} ℚ F] [IsCyclotomicExtension {p * (p ^ f - 1)} ℚ L]
    (𝓠 : Ideal (𝓞 L)) [𝓠.IsPrime] [𝓠.LiesOver (span {(p : ℤ)})] :
    𝓠.ramificationIdx (𝓞 F) = 1 := by
  have h𝓠 : 𝓠.ramificationIdx ℤ = p - 1 := ramificationIdx_eq_p_sub_one f 𝓠
  have tower := ramificationIdx_tower (R := ℤ) (under (𝓞 F) 𝓠) 𝓠
  rw [h𝓠,
    IsCyclotomicExtension.Rat.ramificationIdx_eq_of_prime p F _] at tower
  exact (Nat.mul_eq_left (Nat.sub_ne_zero_of_lt hp.out.one_lt)).mp tower.symm

section ValGaussDigitsPrimePow

open Finset

variable [hp : Fact p.Prime] (f : ℕ) [NeZero f] [IsCyclotomicExtension {p} ℚ F]
  [P.LiesOver (span {(p : ℤ)})] [𝓟.IsMaximal] [𝓟.LiesOver P]

theorem three_le_p_pow [hp' : Fact (Odd p)] : 3 ≤ p ^ f := by
  refine le_trans (Nat.le_pow (NeZero.pos f)) ?_
  exact (Nat.pow_le_pow_iff_left (NeZero.ne f)).mpr <| (Nat.Prime.odd_iff hp.out).mp hp'.out

variable {f P 𝓟 hζ}

section

variable [IsCyclotomicExtension {p * (p ^ f - 1)} ℚ L]

variable (f P hζ) in
include f P hζ in
/-- `ζ - 1` generates the prime of `𝓞 F` below `𝓟`, which is unramified in `L`. -/
theorem zeta_sub_one_notMem_sq : algebraMap (𝓞 F) (𝓞 L) ζ - 1 ∉ 𝓟 ^ 2 := by
  have : 𝓟.LiesOver 𝒑 := LiesOver.trans 𝓟 P 𝒑
  have hspan : under (𝓞 F) 𝓟 = span {ζ - 1} :=
    IsCyclotomicExtension.Rat.eq_span_zeta_sub_one_of_liesOver' p F
      (IsPrimitiveRoot.coe_submonoidClass_iff.mpr hζ) (under (𝓞 F) 𝓟)
  have h : Ideal.map (algebraMap (𝓞 F) (𝓞 L)) (span {ζ - 1}) ≠ ⊥ := by
    apply map_ne_bot_of_ne_bot
    simpa [sub_eq_zero] using hζ.ne_one hp.out.one_lt
  have : NeZero (p ^ f - 1) := ⟨Nat.sub_ne_zero_of_lt (Nat.one_lt_pow (NeZero.ne f) hp.out.one_lt)⟩
  rw [← map_one (f := algebraMap (𝓞 F) (𝓞 L)), ← map_sub, ← dvd_span_singleton,
    ← Set.image_singleton, ← map_span, FiniteMultiplicity.pow_dvd_iff_le_multiplicity
    (Ideal.finiteMultiplicity IsPrime.ne_top' h), ← hspan,
    ← IsDedekindDomain.ramificationIdx_eq_multiplicity (under (𝓞 F) 𝓟) 𝓟 (hspan ▸ h),
    ramificationIdx_under_eq_one p f]
  exact Nat.not_succ_le_self 1

variable [CharP (𝓞 K ⧸ P) p] [Fact (Odd p)] [IsCyclotomicExtension {p ^ f - 1} ℚ K] [P.IsMaximal]
  [P.HasTeichmullerLift (p ^ f - 1)]

theorem valGauss_eq_sum_digits [hcop : Fact ((p ^ f - 1).Coprime p)] (a : ℕ)
    (ha : a ≤ p ^ f - 2) :
    valGauss (p ^ f - 1) P 𝓟 hζ a = (Nat.digits p a).sum := by
  have hf : 1 < p ^ f - 1 := by have : 3 ≤ p ^ f := three_le_p_pow f; lia
  have : NeZero (p ^ f - 1) := ⟨by lia⟩
  have hP : P.inertiaDeg ℤ = f := by
    rw [IsCyclotomicExtension.Rat.inertiaDeg_eq_of_not_dvd (m := p ^ f - 1) p K P,
      ZMod.orderOf_mod_self_pow_sub_one _ _ hp.out.one_lt]
    exact (Nat.Prime.coprime_iff_not_dvd hp.out).mp hcop.out.symm
  have : 𝓟.LiesOver 𝒑 := LiesOver.trans 𝓟 P 𝒑
  have h𝓟 : 𝓟.ramificationIdx ℤ = p - 1 := ramificationIdx_eq_p_sub_one f 𝓟
  have h𝓟' : 2 ≤ 𝓟.ramificationIdx (𝓞 K) := by
    rw [ramificationIdx_eq_sub_one (mul_one (p ^ f - 1)).symm P]
    have : 3 ≤ p := by simpa using (three_le_p_pow 1 : 3 ≤ p ^ 1)
    lia
  have hζ𝓟 : algebraMap (𝓞 F) (𝓞 L) ζ - 1 ∉ 𝓟 ^ 2 := zeta_sub_one_notMem_sq P hζ f
  suffices ∑ i ∈ range (p ^ f - 1), valGauss (p ^ f - 1) P 𝓟 hζ i =
      ∑ i ∈ range (p ^ f - 1), (p.digits i).sum from
     (sum_eq_sum_iff_of_le
      (fun i _ ↦ valGauss_le_sum_digits hf h𝓟' hζ𝓟 _)).mp this a (by grind)
  rw [← Nat.add_left_inj (n := (p.digits (p ^ f - 1)).sum), ← Nat.mul_right_inj two_ne_zero,
    ← Finset.sum_range_succ, Nat.sub_add_cancel (by lia),  Nat.sum_sum_digits_eq hp.out.one_lt,
    mul_add, two_mul_sum_valGauss, Nat.choose_two_right, hP, h𝓟,
    Nat.digits_base_pow_sub_one hp.out.one_lt, List.sum_replicate, smul_eq_mul, ← add_mul,
    Nat.sub_sub, Nat.sub_add_cancel (by lia), eq_comm]
  calc
    _ = (f * p ^ (f - 1) * (2 * (p * (p - 1) / 2))) := by ring
    _ = f * p ^ (f - 1) * (p * (p - 1)) := by rw [Nat.mul_div_eq_iff_dvd.mpr p.two_dvd_mul_sub_one]
    _ = p ^ (f - 1) * p * (f * (p - 1)) := by ring
    _ = p ^ f * (f * (p - 1)) := by rw [← pow_succ, Nat.sub_add_cancel (NeZero.pos f)]

end

end ValGaussDigitsPrimePow

open scoped Pointwise

open IsCyclotomicExtension.Rat

variable {n} {m d : ℕ} {k : IntermediateField ℚ L} (𝔭 : Ideal (𝓞 k))

section Teichmuller

variable [Fact p.Prime] [P.IsMaximal] [P.LiesOver (span {(p : ℤ)})] [CharP (𝓞 K ⧸ P) p] [NeZero n]
  [IsCyclotomicExtension {n} ℚ K]

theorem smul_gaussSum_eq_gaussSum (hmd : n = m * d) (τ : Gal(L/K)) :
    τ • (𝓖 n P hζ d ^ m) = 𝓖 n P hζ d ^ m := by
  obtain ⟨e, he⟩ : ∃ e : (ZMod p)ˣ,
    τ • algebraMap (𝓞 F) (𝓞 L) ζ = algebraMap (𝓞 F) (𝓞 L) ζ ^ e.val.val := by
    replace hζ : IsPrimitiveRoot (algebraMap (𝓞 F) L ζ) p :=
      hζ.map_of_injective (FaithfulSMul.algebraMap_injective _ _)
    refine ⟨hζ.autToPow K τ, ?_⟩
    apply RingOfIntegers.coe_injective
    exact (hζ.autToPow_spec K τ).symm
  rw [smul_pow', gal_gaussSum_eq_mul_gaussSum p τ e he, mul_pow, ← MulChar.pow_apply_coe,
    MulChar.ringHomComp_inv, MulChar.ringHomComp_pow, zpow_neg, inv_inv, zpow_natCast, ← pow_mul',
    ← hmd, MulChar.teichmuller_pow_eq_one, MulChar.ringHomComp_one, MulChar.one_apply_coe, one_mul]

end Teichmuller

section Factorization

theorem span_singleton_gaussSum_eq_prod [Fact p.Prime] [NeZero n] [IsCyclotomicExtension {n} ℚ K]
    [P.IsMaximal] [P.LiesOver 𝒑] [CharP (𝓞 K ⧸ P) p] (a : ℤ) :
    span {𝓖 n P hζ a} =
      ∏ 𝓟 : primesOver 𝒑 (𝓞 L), 𝓟.1 ^ valGauss n P 𝓟 hζ a := by
  classical
  have hp : 𝒑 ≠ ⊥ := by simpa using NeZero.ne p
  have h₁ : span {𝓖 n P hζ a} ≠ 0 := by simpa using gaussSum_ne_zero _
  have h₂ : ∏ 𝓟 : primesOver 𝒑 (𝓞 L), 𝓟.val ^ valGauss n P 𝓟 hζ a ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr fun 𝓟 h𝓟 ↦ pow_ne_zero _ <|
      ne_bot_of_mem_primesOver hp (Subtype.mem 𝓟)
  rw [← associated_iff_eq, UniqueFactorizationMonoid.associated_iff_multiplicity_eq h₁ h₂]
  intro 𝓠 h𝓠
  rw [Finset.multiplicity_prod h𝓠 _ _ (by rwa [h𝓠.finiteMultiplicity_iff_ne_zero])]
  simp_rw [multiplicity_pow h𝓠, Irreducible.multiplicity_eq_ite _ (prime_of_maximal _).irreducible,
    associated_iff_eq, mul_ite, mul_one, mul_zero]
  · by_cases h : 𝓠.LiesOver 𝒑
    · lift 𝓠 to 𝒑.primesOver (𝓞 L) using ⟨isPrime_of_prime h𝓠, h⟩
      simp_rw [Subtype.coe_inj, Fintype.sum_ite_eq, valGauss]
    · have : 𝓠.IsMaximal := (isPrime_of_prime h𝓠).isMaximal h𝓠.ne_zero
      have h𝓟 {𝓟 : primesOver 𝒑 (𝓞 L)} : 𝓠 ≠ 𝓟.val := by
        contrapose h
        exact h ▸ primesOver.liesOver 𝒑 𝓟
      simp_rw [ite_eq_right h𝓟, Finset.sum_const_zero]
      exact valGauss_eq_zero_of_not_liesOver h _

end Factorization

section Galois

variable [NeZero n] [NeZero (m * p)] [P.LiesOver (span {(p : ℤ)})] [IsCyclotomicExtension {n} ℚ K]

open IsCyclotomicExtension

variable (p F) in
theorem modEq_one_of_apply_eq_pow (hmd : n = m * d) (E : IntermediateField ℚ L)
    [IsCyclotomicExtension {m * p} ℚ E] (η : L) (hη : IsPrimitiveRoot η n)
    (τ : Gal(L/E)) (a : ℕ) (hτ : τ η = η ^ a) :
    a ≡ 1 [MOD m] := by
  let ν := algebraMap E L (zeta (m * p) ℚ E ^ p)
  have hν : IsPrimitiveRoot ν m := by
    refine IsPrimitiveRoot.map_of_injective ?_ (FaithfulSMul.algebraMap_injective E L)
    exact (zeta_spec (m * p) ℚ E).pow (NeZero.pos _) (by rw [mul_comm])
  obtain ⟨k, _, hk⟩ := hη.eq_pow_of_pow_eq_one (by rw [hmd, pow_mul, hν.pow_eq_one, one_pow])
  have := congr_arg τ hk
  rw [map_pow, hτ, AlgEquiv.commutes, pow_right_comm, hk] at this
  rwa [hν.eq_orderOf, ← (hν.isOfFinOrder (by lia)).pow_eq_pow_iff_modEq, pow_one]

variable [CharP (𝓞 K ⧸ P) p] [IsCyclotomicExtension {p} ℚ F] [IsCyclotomicExtension {p * n} ℚ L]

theorem smul_gaussSum_eq_gaussSum' [NeZero p] [Fact (n.Coprime p)] (hmd : n = m * d)
    (E : IntermediateField ℚ L) [IsCyclotomicExtension {m * p} ℚ E] [Algebra F E]
    [IsScalarTower F E L] (τ : Gal(L/E)) :
    τ • 𝓖 n P hζ d = 𝓖 n P hζ d := by
  suffices d * (galFEquiv p n K F (AlgEquiv.restrictScalars F τ)).val.val ≡ d * 1 [ZMOD n] by
    change τ.restrictScalars F • 𝓖 n P hζ d = 𝓖 n P hζ d
    rw [gal_gaussSum_eq_gaussSum]
    exact gaussSum_congr (by rwa [mul_one] at this)
  convert_to Int.ModEq (d * m) _ _
  · rw [← Nat.cast_mul, mul_comm, hmd]
  refine Int.ModEq.mul_left' ?_
  rw [← Nat.cast_one, Int.natCast_modEq_iff]
  refine modEq_one_of_apply_eq_pow p hmd E (algebraMap K L (zeta n ℚ K)) ?_ τ _ ?_
  · exact (zeta_spec n ℚ K).map_of_injective <| FaithfulSMul.algebraMap_injective K L
  · rw [← (zeta_spec n ℚ K).galLFEquiv_apply p, AlgEquiv.coe_restrictScalars]

variable [Fact p.Prime] [hnp : Fact (n.Coprime p)] [P.IsMaximal]

-- Used in `SKW.Stickelberger.Stickelberger`.
variable (k) in
theorem exists_mem_gaussSum_pow_eq (hmd : n = m * d) [IsCyclotomicExtension {m} ℚ k] :
    ∃ Γ : 𝓞 k, 𝓖 n P hζ d ^ m = algebraMap (𝓞 k) (𝓞 L) Γ := by
  have : IsAbelianGalois ℚ L := IsCyclotomicExtension.isAbelianGalois {p * n} ℚ L
  let ξ := zeta (p * n) ℚ L
  have hξ := zeta_spec (p * n) ℚ L
  let η := ξ ^ d
  have hη : IsPrimitiveRoot η (m * p) := hξ.pow (NeZero.pos _) (by grind)
  let E := ℚ⟮η⟯
  have : IsCyclotomicExtension {m * p} ℚ E := hη.intermediateField_adjoin_isCyclotomicExtension ℚ
  let : Algebra F E := by
    have : F ≤ E := isCyclotomicExtension_le_of_dvd _ _ _ _ _ _ (p.dvd_mul_left m)
    exact (inclusion this).toRingHom.toAlgebra
  have : IsScalarTower F E L := IsScalarTower.of_algebraMap_eq' rfl
  obtain ⟨Γ₀, h₀⟩ : ∃ Γ₀ : K, Γ₀ = (𝓖 n P hζ d ^ m : L) :=
    IsGaloisGroup.isInvariant.isInvariant _ fun τ : Gal(L/K) ↦ by
      exact_mod_cast smul_gaussSum_eq_gaussSum P hζ hmd τ
  obtain ⟨Γ₁, h₁⟩ : ∃ Γ₁ : E, Γ₁ = (𝓖 n P hζ d ^ m : L) :=
    IsGaloisGroup.isInvariant.isInvariant _ fun τ : Gal(L/E) ↦ by
      rw [smul_pow', RingOfIntegers.coe_eq_algebraMap, ← algebraMap.smul',
        smul_gaussSum_eq_gaussSum' P hζ hmd]
  have hk : k = K ⊓ E := by
    have := IsCyclotomicExtension.Rat.gcd_inf n (m * p) K E
    rw [hmd, Nat.gcd_mul_left, hnp.out.coprime_dvd_left (Dvd.intro_left m hmd.symm), mul_one]
      at this
    exact IntermediateField.isCyclotomicExtension_eq {m} ℚ L k ↑(K ⊓ E)
  let Γ : 𝓞 k := (⟨⟨𝓖 n P hζ d ^ m, hk ▸ ⟨h₀ ▸ Subtype.coe_prop Γ₀, h₁ ▸ Subtype.coe_prop Γ₁⟩⟩ ,
      isIntegral_algebraMap_iff.mp ((𝓖 n P hζ d).isIntegral_coe.pow m)⟩ : 𝓞 k)
  exact ⟨Γ, rfl⟩

end Galois

section PrimePow

variable (m) [IsCyclotomicExtension {m} ℚ k] (f : ℕ)

include m in
theorem mem_orbit [𝔭.IsPrime] [𝔭.LiesOver 𝒑] (𝔮 : 𝒑.primesOver (𝓞 k)) :
    (𝔮 : Ideal (𝓞 k)) ∈ MulAction.orbit Gal(k/ℚ) 𝔭 := by
  have := IsCyclotomicExtension.isGalois {m} ℚ k
  rw [Algebra.IsInvariant.orbit_eq_primesOver ℤ _ _ 𝒑 𝔭]
  exact 𝔮.2

section equivUnits

variable [NeZero m]

/-- A unit `a` such that `σₐ⁻¹ • 𝔭 = 𝔮`. -/
noncomputable def unitRep [𝔭.IsPrime] [𝔭.LiesOver 𝒑] (𝔮 : 𝒑.primesOver (𝓞 k)) : (ZMod m)ˣ :=
  (galEquivZMod m k (MulAction.mem_orbit_iff.mp (mem_orbit m 𝔭 𝔮)).choose)⁻¹

theorem unitRep_spec [𝔭.IsPrime] [𝔭.LiesOver 𝒑] (𝔮 : 𝒑.primesOver (𝓞 k)) :
    ((galEquivZMod m k).symm (unitRep m 𝔭 𝔮)⁻¹) • 𝔭 = 𝔮 := by
  rw [unitRep, inv_inv, MulEquiv.symm_apply_apply,
    (MulAction.mem_orbit_iff.mp (mem_orbit m 𝔭 𝔮)).choose_spec]

/-- The map `(𝔮, j) ↦ unitRep 𝔮 * p ^ j`. -/
noncomputable def toUnits [𝔭.IsPrime] [𝔭.LiesOver 𝒑] (hp' : p.Coprime m) :
    𝒑.primesOver (𝓞 k) × Fin f → (ZMod m)ˣ :=
  fun x ↦ unitRep m 𝔭 x.1 * ZMod.unitOfCoprime p hp' ^ (x.2 : ℕ)

theorem toUnits_apply [𝔭.IsPrime] [𝔭.LiesOver 𝒑] (hp' : p.Coprime m)
    (x : 𝒑.primesOver (𝓞 k) × Fin f) :
    toUnits m 𝔭 f hp' x = unitRep m 𝔭 x.1 * ZMod.unitOfCoprime p hp' ^ (x.2 : ℕ) := rfl

variable [hp : Fact p.Prime] {m 𝔭 f}

theorem toUnits_spec [𝔭.IsMaximal] [𝔭.LiesOver 𝒑] (hp' : p.Coprime m)
    (x : 𝒑.primesOver (𝓞 k) × Fin f) :
    (galEquivZMod m k).symm (toUnits m 𝔭 f hp' x)⁻¹ • 𝔭 = x.1 := by
  rw [toUnits_apply, mul_inv, map_mul, mul_smul, MulAction.mem_stabilizer_iff (a := 𝔭).mp,
    unitRep_spec]
  rw [← Subgroup.mem_map_equiv, ← MulEquiv.coe_mapSubgroup, galEquivZMod_stabilizer m k p _ hp',
    Subgroup.inv_mem_iff]
  exact Subgroup.npow_mem_zpowers _ _

theorem toUnits_injective [𝔭.IsMaximal] [𝔭.LiesOver 𝒑] (hp' : p.Coprime m)
    (hmf : orderOf (p : ZMod m) = f) :
    Function.Injective (toUnits m 𝔭 f hp') := by
  intro ⟨x₁, x₂⟩ ⟨y₁, y₂⟩ h
  have h₁ : x₁ = y₁ := by
    simpa only [Subtype.ext_iff, toUnits_spec] using congr_arg ((galEquivZMod m k).symm ·⁻¹ • 𝔭) h
  refine Prod.mk_inj.mpr ⟨h₁, Fin.eq_of_val_eq ?_⟩
  rw [toUnits_apply, toUnits_apply, h₁, mul_right_inj] at h
  refine pow_injOn_Iio_orderOf ?_ ?_ h <;> simp [← orderOf_units, ZMod.coe_unitOfCoprime, hmf]

theorem toUnits_surjective [𝔭.IsMaximal] [𝔭.LiesOver 𝒑] (hp' : p.Coprime m)
    (hmf : orderOf (p : ZMod m) = f) :
    Function.Surjective (toUnits m 𝔭 f hp') := by
  intro y
  let 𝔮 : 𝒑.primesOver (𝓞 k) := primesOver.mk 𝒑 (((galEquivZMod m k).symm y)⁻¹ • 𝔭)
  obtain ⟨c, hc⟩ : ∃ c : Fin (orderOf (ZMod.unitOfCoprime p hp')),
      ZMod.unitOfCoprime p hp' ^ c.val = y * (unitRep m 𝔭 𝔮)⁻¹ := by
    have : (galEquivZMod m k).symm (y * (unitRep m 𝔭 𝔮)⁻¹) ∈ MulAction.stabilizer Gal(k/ℚ) 𝔭 := by
      rw [MulAction.mem_stabilizer_iff, map_mul, mul_smul, unitRep_spec m 𝔭 𝔮,
        smul_eq_iff_eq_inv_smul]
    have := pow_finEquivZPowers_symm_apply (isOfFinOrder_of_finite _)
      ⟨_, mem_zpowers_galEquivZMod_of_mem_stabilizer m k p 𝔭 hp' this⟩
    exact ⟨_, by simpa only [map_mul, map_inv, MulEquiv.apply_symm_apply, this]⟩
  refine ⟨⟨𝔮, finCongr (by rw [← orderOf_units, ZMod.coe_unitOfCoprime, hmf]) c⟩, ?_⟩
  rw [toUnits_apply, finCongr_apply, Fin.val_cast, hc, mul_inv_cancel_comm_assoc]

variable (m 𝔭 f)

/-- An equivalence between pairs `(𝔮, j)`, with `𝔮` a prime of `𝓞 k` above `p` and `j < f`, and
`(ZMod m)ˣ`, such that the image `a` of `(𝔮, j)` satisfies `σₐ⁻¹ • 𝔭 = 𝔮`. -/
noncomputable def equivUnits [𝔭.IsMaximal] [𝔭.LiesOver 𝒑] (hp' : p.Coprime m)
    (hmf : orderOf (p : ZMod m) = f) :
    𝒑.primesOver (𝓞 k) × Fin f ≃ (ZMod m)ˣ :=
  Equiv.ofBijective (toUnits m 𝔭 f hp')
    ⟨toUnits_injective hp' hmf, toUnits_surjective hp' hmf⟩

variable {m 𝔭 f}

theorem equivUnits_apply [𝔭.IsMaximal] [𝔭.LiesOver 𝒑] (hp' : p.Coprime m)
    (hmf : orderOf (p : ZMod m) = f) (x : 𝒑.primesOver (𝓞 k) × Fin f) :
    equivUnits m 𝔭 f hp' hmf x = unitRep m 𝔭 x.1 * ZMod.unitOfCoprime p hp' ^ (x.2 : ℕ) := rfl

theorem equivUnits_spec [𝔭.IsMaximal] [𝔭.LiesOver 𝒑] (hp' : p.Coprime m)
    (hmf : orderOf (p : ZMod m) = f) (x : 𝒑.primesOver (𝓞 k) × Fin f) :
    ((galEquivZMod m k).symm (equivUnits m 𝔭 f hp' hmf x)⁻¹) • 𝔭 = x.1 :=
  toUnits_spec hp' x

theorem equivUnits_add [𝔭.IsMaximal] [𝔭.LiesOver 𝒑] (hp' : p.Coprime m)
    (hmf : orderOf (p : ZMod m) = f) (𝔮 : 𝒑.primesOver (𝓞 k)) (i j : Fin f) :
    (equivUnits m 𝔭 f hp' hmf (𝔮, i + j)).val =
      equivUnits m 𝔭 f hp' hmf (𝔮, i) * p ^ j.val := by
  simp [equivUnits_apply, Units.val_mul, Units.val_pow_eq_pow_val, ZMod.coe_unitOfCoprime,
    mul_assoc, ← pow_add, Fin.val_add, ← pow_eq_pow_mod _ (hmf ▸ pow_orderOf_eq_one (p : ZMod m))]

theorem exists_equivUnits_eq [𝔭.IsMaximal] [𝔭.LiesOver 𝒑] (hp' : p.Coprime m)
    (hmf : orderOf (p : ZMod m) = f) {𝔮 : 𝒑.primesOver (𝓞 k)} {a : (ZMod m)ˣ}
    (ha : (galEquivZMod m k).symm a⁻¹ • 𝔭 = 𝔮) :
    ∃ j, equivUnits m 𝔭 f hp' hmf (𝔮, j) = a := by
  obtain ⟨⟨𝔮', j⟩, rfl⟩ := (equivUnits m 𝔭 f hp' hmf).surjective a
  rw [show 𝔮 = 𝔮' from Subtype.ext <| ha.symm.trans (equivUnits_spec hp' hmf _)]
  exact ⟨j, rfl⟩

theorem sum_equivUnits [NeZero f] [𝔭.IsMaximal] [𝔭.LiesOver 𝒑] (hp' : p.Coprime m)
    (hmf : orderOf (p : ZMod m) = f) {𝔮 : 𝒑.primesOver (𝓞 k)}
    (a : (ZMod m)ˣ) (ha : ((galEquivZMod m k).symm a⁻¹) • 𝔭 = 𝔮) :
    ∑ j : Fin f, (equivUnits m 𝔭 f hp' hmf (𝔮, j) : ZMod m).val =
      ∑ j : Fin f, ((a : ZMod m) * p ^ (j : ℕ)).val := by
  obtain ⟨j, rfl⟩ := exists_equivUnits_eq hp' hmf ha
  simp_rw [← equivUnits_add]
  exact (Equiv.sum_comp (Equiv.addLeft j) _).symm

end equivUnits

variable [IsCyclotomicExtension {p ^ f - 1} ℚ K] [IsCyclotomicExtension {p * (p ^ f - 1)} ℚ L]
  [P.IsMaximal] [P.LiesOver (span {(p : ℤ)})] [P.HasTeichmullerLift (p ^ f - 1)]
  [𝓟.LiesOver P]

variable {P 𝓟 hζ 𝔭}

theorem restrictNormal_smul_eq [IsGalois ℚ k] [IsGalois ℚ L] [h𝓟 : 𝓟.LiesOver 𝔭]
    {𝔮 : 𝒑.primesOver (𝓞 k)} {𝓠 : (𝔮 : Ideal (𝓞 k)).primesOver (𝓞 L)} {τ : Gal(L/F)}
    (hτ : τ • 𝓟 = 𝓠) :
    (τ.restrictScalars ℚ).restrictNormal k • 𝔭 = 𝔮 := by
  rw [← IsGaloisGroup.restrictHom_eq_restrictNormal,
    ← IsGaloisGroup.restrictHom_eq_restrictHom Gal(L/ℚ) Gal(k/ℚ) ℤ (𝓞 k) (𝓞 L) ℚ k L,
    (liesOver_iff _ _).mp h𝓟, IsGaloisGroup.restrictHom_smul_under, (liesOver_iff _ _).mp 𝓠.2.2,
    ← hτ]
  rfl

variable [hp : Fact (Nat.Prime p)] [IsCyclotomicExtension {p} ℚ F] [𝓟.IsMaximal]

/-- The automorphism of `k` given by the image of `galFEquiv τ` in `(ZMod m)ˣ` is the restriction
of `τ` to `k`. -/
theorem galEquivZMod_symm_unitsMap_galFEquiv [NeZero (p ^ f - 1)] [NeZero m]
     [Fact ((p ^ f - 1).Coprime p)] [Normal ℚ k]
    (h : m ∣ p ^ f - 1) (τ : Gal(L/F)) :
    (galEquivZMod m k).symm (ZMod.unitsMap h (galFEquiv p (p ^ f - 1) K F τ)) =
      (τ.restrictScalars ℚ).restrictNormal k := by
  have := IsCyclotomicExtension.isAbelianGalois {p * (p ^ f - 1)} ℚ L
  have : NeZero (p * (p ^ f - 1)) := ⟨mul_ne_zero (NeZero.ne p) (NeZero.ne _)⟩
  rw [MulEquiv.symm_apply_eq, galFEquiv_eq,
    galEquivZMod_restrictNormal_apply (p * (p ^ f - 1)) L K (dvd_mul_left _ p),
    galEquivZMod_restrictNormal_apply (p * (p ^ f - 1)) L k (h.mul_left p |>.trans ?_),
    ← MonoidHom.comp_apply, ZMod.unitsMap_comp]
  rfl

variable [CharP (𝓞 K ⧸ P) p] {m f} [NeZero f]

theorem mul_valGauss_eq_mul_sum [Fact (Odd p)] [Fact ((p ^ f - 1).Coprime p)]
    (hmd : p ^ f - 1 = m * d) {a : ℕ} (ha : d * a ≤ p ^ f - 2) :
    m * valGauss (p ^ f - 1) P 𝓟 hζ (d * a) =
      (p - 1) * ∑ i ∈ Finset.range f, a * p ^ i % m := by
  have hf : 1 < p ^ f - 1 := by have : 3 ≤ p ^ f := three_le_p_pow f; lia
  rw [← mul_right_inj' (by grind : d ≠ 0), ← Nat.cast_mul, valGauss_eq_sum_digits _ ha,
    ← mul_assoc, mul_comm d, ← hmd, ← Nat.sub_one_mul_sum_mod_eq hp.out.one_lt (by lia),
    mul_left_comm, Finset.mul_sum _ _ d]
  refine congr_arg ((p - 1) * ·) <| Finset.sum_congr rfl fun i hi ↦ ?_
  rw [hmd, mul_assoc, mul_comm m, Nat.mul_mod_mul_left]

variable [NeZero m]

variable (p) in
/-- There is a single prime of `𝓞 F` above `p`, so any prime of `𝓞 L` above `p` lies over the prime
of `𝓞 F` below `𝓟`. -/
theorem liesOver_under_of_liesOver [𝓟.LiesOver 𝒑] {𝓠 : Ideal (𝓞 L)} [𝓠.IsPrime]
    [𝓠.LiesOver 𝒑] : 𝓠.LiesOver (under (𝓞 F) 𝓟) := by
  obtain ⟨Q, hQ⟩ := Set.ncard_eq_one.mp (ncard_primesOver_of_prime p F)
  have h₁ : under (𝓞 F) 𝓟 ∈ primesOver 𝒑 (𝓞 F) := ⟨inferInstance, inferInstance⟩
  have h₂ : under (𝓞 F) 𝓠 ∈ primesOver 𝒑 (𝓞 F) := ⟨inferInstance, inferInstance⟩
  rw [hQ] at h₁ h₂
  exact (liesOver_iff _ _).mpr (h₁.trans h₂.symm)

variable (P 𝓟 hζ 𝔭)

theorem mul_valGauss_eq [Fact (Odd p)] [NeZero (p ^ f - 1)] [Fact ((p ^ f - 1).Coprime p)]
    (hmf : orderOf (p : ZMod m) = f) (hmd : p ^ f - 1 = m * d)
    (hp' : p.Coprime m) [𝔭.IsMaximal] [𝔭.LiesOver 𝒑] [h𝓟 : 𝓟.LiesOver 𝔭] (𝔮 : 𝒑.primesOver (𝓞 k))
    (𝓠 : (𝔮 : Ideal (𝓞 k)).primesOver (𝓞 L)) :
    m * valGauss (p ^ f - 1) P 𝓠 hζ d =
      (p - 1) * ∑ i, (equivUnits m 𝔭 f hp' hmf (𝔮, i) : ZMod m).val := by
  have hd : 0 < d := Nat.pos_of_mul_pos_left (hmd ▸ NeZero.pos (p ^ f - 1))
  have := IsCyclotomicExtension.isAbelianGalois {p * (p ^ f - 1)} ℚ L
  have : 𝓠.val.LiesOver (under (𝓞 F) 𝓟) := by
    have : 𝓟.LiesOver 𝒑 := LiesOver.trans 𝓟 P _
    have : 𝓠.val.LiesOver 𝒑 := LiesOver.trans 𝓠.val 𝔮.val _
    exact liesOver_under_of_liesOver p
  obtain ⟨τ, hτ⟩ : ∃ τ, τ • 𝓟 = 𝓠 := exists_smul_eq_of_isGaloisGroup (under (𝓞 F) 𝓟) 𝓟 𝓠 Gal(L/F)
  set a : (ZMod m)ˣ := ZMod.unitsMap ⟨d, hmd⟩ (galFEquiv p (p ^ f - 1) K F τ⁻¹)
    with a_def
  rw [← hτ, valGauss_smul, valGauss_periodic _ (d * a.val.val), mul_valGauss_eq_mul_sum hmd,
    sum_equivUnits hp' hmf a, Finset.sum_range]
  · refine congr_arg ((p - 1) * ·) <| Finset.sum_congr rfl fun i _ ↦ ?_
    rw [ZMod.val_mul, ← Nat.cast_pow, ZMod.val_natCast, Nat.mul_mod_mod]
  · rw [a_def, map_inv, map_inv, map_inv, map_inv, inv_inv, galEquivZMod_symm_unitsMap_galFEquiv]
    exact restrictNormal_smul_eq hτ
  · rw [show p ^ f - 2 = p ^ f - 1 - 1 by lia, Nat.le_sub_one_iff_lt (NeZero.pos _), hmd,
      mul_comm m, Nat.mul_lt_mul_left hd]
    exact ZMod.val_lt _
  · rw [congr_arg ((↑) : ℕ → ℤ) hmd, Nat.cast_mul, mul_comm (m : ℤ), ZMod.unitsMap_val]
    exact Int.ModEq.mul_left' <| (ZMod.intCast_eq_intCast_iff _ _ m).mp <| by simp

variable {P hζ}

-- Used in `SKW.Stickelberger.Stickelberger`.
theorem gaussSum_factorization [Fact (Odd p)] [NeZero (p ^ f - 1)]
    [hcop : Fact ((p ^ f - 1).Coprime p)]
    (hmf : orderOf (p : ZMod m) = f) (hmd : p ^ f - 1 = m * d) [𝔭.IsMaximal] [𝔭.LiesOver 𝒑]
    [𝓟.LiesOver 𝔭] {Γ : 𝓞 k} (hΓ : 𝓖 (p ^ f - 1) P hζ d ^ m = algebraMap (𝓞 k) (𝓞 L) Γ) :
    span {Γ} = ∏ a : (ZMod m)ˣ, (((galEquivZMod m k).symm a)⁻¹ • 𝔭) ^ a.val.val := by
  have h₀ : 𝔭 ≠ ⊥ := IsMaximal.ne_bot_of_isIntegral_int 𝔭
  have h₁ : m ∣ p * (p ^ f - 1) := by
    rw [hmd, mul_rotate']
    exact Nat.dvd_mul_right m (d * p)
  have hp' : p.Coprime m := hcop.out.symm.of_dvd_right ⟨d, hmd⟩
  have h𝔭₁ {σ : Gal(k/ℚ)} : σ • 𝔭 ≠ ⊥ := (smul_ne_zero_iff_ne _).mpr <| h₀
  have h𝔭₂ {σ : Gal(k/ℚ)} : (σ • 𝔭).IsMaximal := isMaximal_of_isPrime_of_ne_bot (σ • 𝔭) h𝔭₁
  have h𝔮 (σ : Gal(k/ℚ)) : ((σ • 𝔭).primesOver (𝓞 L)).toFinset =
        IsDedekindDomain.primesOverFinset (σ • 𝔭) (𝓞 L) := by
      rw [← Finset.coe_inj, IsDedekindDomain.coe_primesOverFinset h𝔭₁, Set.coe_toFinset]
  have h𝓠 {𝔮 : Ideal (𝓞 k)} [𝔮.IsMaximal] [𝔮.LiesOver 𝒑] {𝓠 : 𝔮.primesOver (𝓞 L)} :
      𝓠.val.ramificationIdx (𝓞 k) = p - 1 :=
    ramificationIdx_eq_sub_one hmd 𝔮
  apply map_injective_of_faithfullyFlat (B := (𝓞 L))
  simp_rw [map_span, Set.image_singleton, ← hΓ, ← span_singleton_pow,
    span_singleton_gaussSum_eq_prod, ← mapHom_apply, map_prod, mapHom_apply, Ideal.map_pow,
    map_algebraMap_eq_finsetProd_pow h𝔭₁, ← Finset.prod_pow,
    ← Equiv.prod_comp (equivUnits m 𝔭 f hp' hmf), Fintype.prod_prod_type, ← map_inv,
    equivUnits_spec, Finset.prod_comm (γ := Fin f), ← pow_mul, Finset.prod_pow_eq_pow_sum,
    ← Finset.prod_set_coe, ← Equiv.prod_comp (equivPrimesOverPrimesOver (𝓞 k) 𝒑 (B := 𝓞 L)).symm,
    Fintype.prod_sigma, coe_equivPrimesOverPrimesOver_symm_apply]
  refine Finset.prod_congr rfl fun 𝔮 _ ↦ Finset.prod_congr rfl fun 𝓠 _ ↦ ?_
  rw [h𝓠, ← Finset.mul_sum, mul_comm, mul_valGauss_eq P 𝓟 hζ 𝔭 hmf hmd hp' 𝔮 𝓠]

end PrimePow

end Stickelberger

namespace Stickelberger

open Ideal NumberField IntermediateField Pointwise IsCyclotomicExtension Rat

variable {p : ℕ} [hp : Fact (p.Prime)]

-- variable  (k : Type*) [Field k] [NumberField k]
--   -- (k : IntermediateField ℚ L)
--   [NeZero m]
--   [IsCyclotomicExtension {m} ℚ k]  (hp' : ¬ p ∣ m)
--   (𝔭 : Ideal (𝓞 k)) [𝔭.IsMaximal] [𝔭.LiesOver (span {(p : ℤ)})]

local notation3 "𝒑" => span {(p : ℤ)}

attribute [local instance] Ideal.Quotient.field in
theorem hasTeichmullerLift {f : ℕ} [NeZero (p ^ f - 1)] [hcop : Fact ((p ^ f - 1).Coprime p)]
    {K : Type*} [Field K] [NumberField K] [IsCyclotomicExtension {p ^ f - 1} ℚ K]
    (P : Ideal (𝓞 K)) [P.IsMaximal] [P.LiesOver 𝒑] :
    P.HasTeichmullerLift (p ^ f - 1) := by
  have hζ := (zeta_spec (p ^ f - 1) ℚ K).toInteger_isPrimitiveRoot
  have : HasEnoughRootsOfUnity (𝓞 K) (p ^ f - 1) := ⟨⟨_, hζ⟩, rootsOfUnity.isCyclic _ _⟩
  refine .of_card_of_isPrime (p ^ f - 1) ?_
  rw [Nat.card_units, tsub_left_inj Nat.card_pos NeZero.one_le, ← absNorm_eq_card,
    ← absNorm_pow_inertiaDeg 𝒑, absNorm_eq_card, Int.card_ideal_quot,
    IsCyclotomicExtension.Rat.inertiaDeg_eq_of_not_dvd (m := p ^ f - 1) p K P,
    ZMod.orderOf_mod_self_pow_sub_one _ _ hp.out.one_lt]
  exact (Nat.Prime.coprime_iff_not_dvd hp.out).mp hcop.out.symm

variable (p) [Fact (Odd p)]

attribute [local instance] Ideal.Quotient.field in
theorem Stickelberger₀ (f d : ℕ) [NeZero f] [NeZero (p ^ f - 1)] (L : Type*) [Field L]
    [NumberField L] [IsCyclotomicExtension {p * (p ^ f - 1)} ℚ L] (m : ℕ) [NeZero m]
    (k : IntermediateField ℚ L) [IsCyclotomicExtension {m} ℚ k] (𝔭 : Ideal (𝓞 k)) [𝔭.IsMaximal]
    [𝔭.LiesOver 𝒑] (hmd : p ^ f - 1 = m * d) (hpf : orderOf (p : ZMod m) = f) :
    Submodule.IsPrincipal (∏ a : (ZMod m)ˣ, (((galEquivZMod m k).symm a)⁻¹ • 𝔭) ^ a.val.val) := by
  have : Fact ((p ^ f - 1).Coprime p) := ⟨by
    rw [← Nat.coprime_pow_right_iff (NeZero.pos f), Nat.coprime_self_sub_left NeZero.one_le]
    exact Nat.gcd_one_left _⟩
  have := isAbelianGalois {p * (p ^ f - 1)} ℚ L
  let ξ := IsCyclotomicExtension.zeta (p * (p ^ f - 1)) ℚ L
  have hξ := IsCyclotomicExtension.zeta_spec (p * (p ^ f - 1)) ℚ L
  let ζ := ξ ^ (p ^ f - 1)
  have hζ : IsPrimitiveRoot ζ p := hξ.pow (NeZero.pos _) (by rw [mul_comm])
  let F := ℚ⟮ζ⟯
  have : IsCyclotomicExtension {p} ℚ F := hζ.intermediateField_adjoin_isCyclotomicExtension ℚ
  let η := ξ ^ p
  have hη : IsPrimitiveRoot η (p ^ f - 1) := hξ.pow (NeZero.pos _) rfl
  let K := ℚ⟮η⟯
  have : IsCyclotomicExtension {p ^ f - 1} ℚ K :=
    hη.intermediateField_adjoin_isCyclotomicExtension ℚ
  obtain ⟨𝓟, h𝓟, _⟩ := exists_maximal_ideal_liesOver_of_isIntegral (S := 𝓞 L) 𝔭
  have : 𝓟.LiesOver 𝒑 := LiesOver.trans 𝓟 𝔭 𝒑
  let P := under (𝓞 K) 𝓟
  have : P.HasTeichmullerLift (p ^ f - 1) := hasTeichmullerLift P
  have hP : P.LiesOver 𝒑 := under_liesOver_of_liesOver (𝓞 K) 𝓟 𝒑
  have : CharP (𝓞 K ⧸ P) p := by
    refine ringChar.of_eq  ?_
    rw [Ideal.ringChar_quot P, ← (liesOver_iff _ _).mp hP, absNorm_eq_card, Int.card_ideal_quot]
  obtain ⟨Γ, hΓ⟩ := exists_mem_gaussSum_pow_eq P (zeta_spec p ℚ F).toInteger_isPrimitiveRoot k hmd
  exact ⟨Γ, by rw [Ideal.submodule_span_eq, gaussSum_factorization 𝓟 𝔭 hpf hmd hΓ]⟩

theorem Stickelberger₁ (k : Type*) [Field k] [NumberField k] (m : ℕ) [NeZero m]
    [IsCyclotomicExtension {m} ℚ k] (𝔭 : Ideal (𝓞 k)) [𝔭.IsMaximal] [𝔭.LiesOver 𝒑]
    (hmp : p.Coprime m) :
    Submodule.IsPrincipal (∏ a : (ZMod m)ˣ, (((galEquivZMod m k).symm a)⁻¹ • 𝔭) ^ a.val.val) := by
  set f := orderOf (p : ZMod m) with f_def
  let d := (p ^ f - 1) / m
  have h_mdiv : m ∣ p ^ f - 1 := by
    refine (Nat.modEq_iff_dvd' (Nat.one_le_pow _ _ hp.out.pos)).mp ?_
    rw [← ZMod.natCast_eq_natCast_iff, Nat.cast_pow, pow_orderOf_eq_one, Nat.cast_one]
  have hmd : p ^ f - 1 = m * d := Nat.eq_mul_of_div_eq_right h_mdiv rfl
  have : NeZero f := ⟨by
    rw [f_def, ← ZMod.coe_unitOfCoprime p hmp, orderOf_units]
    exact orderOf_ne_zero_iff.mpr <| isOfFinOrder_of_finite _⟩
  have : NeZero (p ^ f - 1) := ⟨Nat.sub_ne_zero_of_lt (Nat.one_lt_pow (NeZero.ne f) hp.out.one_lt)⟩
  obtain ⟨ξ, hξ⟩ :=
    HasEnoughRootsOfUnity.exists_isPrimitiveRoot (AlgebraicClosure k) (p * (p ^ f - 1))
  let L := ℚ⟮ξ⟯
  have : NumberField L := {
      to_finiteDimensional := adjoin.finiteDimensional <| hξ.isIntegral' (NeZero.pos _) }
  have : IsCyclotomicExtension {p * (p ^ f - 1)} ℚ L := hξ.adjoinSimple_isCyclotomicExtension _ ℚ
  let η := (zeta (p * (p ^ f - 1)) ℚ L) ^ (p * d)
  have hη : IsPrimitiveRoot η m :=
    (zeta_spec (p * (p ^ f - 1)) ℚ L).pow (NeZero.pos _) <| by rw [hmd, mul_comm m, mul_assoc]
  let k₀ := ℚ⟮η⟯
  have : IsCyclotomicExtension {m} ℚ k₀ := hη.adjoinSimple_isCyclotomicExtension _ ℚ
  let e : (𝓞 k₀) ≃+* (𝓞 k) :=
    RingOfIntegers.mapRingEquiv <| (IsCyclotomicExtension.algEquiv {m} ℚ k₀ k).toRingEquiv
  let 𝔭₀ := Ideal.comap e 𝔭
  have :  𝔭₀.LiesOver 𝒑 := by
    change (Ideal.comap e.toIntAlgEquiv 𝔭).LiesOver 𝒑
    apply Ideal.comap_liesOver
  have ha {a} : ((galEquivZMod m k).symm a)⁻¹ • 𝔭 =
      Ideal.mapHom e (((galEquivZMod m k₀).symm a)⁻¹ • 𝔭₀) := by
    ext x
    have := ringHom_galEquivZMod_smul (f := e.toRingHom) e.injective a (e.symm x)
    simp only [RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, RingEquiv.apply_symm_apply] at this
    rw [mapHom_apply, show map e _ = _ from map_comap_of_equiv (e : 𝓞 k₀ ≃+* 𝓞 k), mem_comap,
      Ideal.mem_inv_pointwise_smul_iff, Ideal.mem_inv_pointwise_smul_iff, ← this, ← mem_comap]
  simp_rw [ha, ← map_pow, ← map_prod]
  exact Submodule.IsPrincipal.map_ringHom e <| Stickelberger₀ p f d L m k₀ 𝔭₀ hmd rfl

theorem Stickelberger (k : Type*) [Field k] [NumberField k] (m : ℕ) [NeZero m]
    [IsCyclotomicExtension {m} ℚ k] (C : ClassGroup (𝓞 k)) :
    ∏ a : (ZMod m)ˣ, (((galEquivZMod m k).symm a)⁻¹ • C) ^ a.val.val = 1 := by
  obtain ⟨⟨I, hI⟩, rfl, hI'⟩ := ClassGroup.exists_mk0_eq_and_isCoprime C
    (J := span {(2*m : 𝓞 k)}) (by simpa using NeZero.ne m)
  simp_rw [ClassGroup.smul_mk0, ← map_pow, ← map_prod]
  rw [ClassGroup.mk0_eq_one_iff]
  have hI : I ≠ ⊥ := mem_nonZeroDivisors_iff_ne_zero.mp hI
  simp only [← mem_isPrincipalSubmonoid_iff, SubmonoidClass.coe_finsetProd, SubmonoidClass.coe_pow,
    nonZeroDivisors.val_smul]
  rw [← Ideal.prod_normalizedFactors_eq_self hI]
  simp_rw +singlePass [← smul_pow', ← Multiset.map_id',
    ← Multiset.prod_map_pow, pointwise_smul_def, ← mapHom_apply, map_multiset_prod,
    Multiset.map_map, ← Multiset.prod_map_prod]
  refine Submonoid.multiset_prod_mem _ _ (fun P hP ↦ mem_isPrincipalSubmonoid_iff.mp ?_)
  by_cases hP₀ : P = 0
  · simpa [hP₀] using! bot_isPrincipal
  rw [← Subtype.coe_mk P (mem_nonZeroDivisors_of_ne_zero hP₀)]
  obtain ⟨𝔭, h𝔭, rfl⟩ := Multiset.mem_map.mp hP
  obtain ⟨h𝔭₁, h𝔭₂⟩ := (UniqueFactorizationMonoid.mem_normalizedFactors_iff hI).mp h𝔭
  have : NeZero 𝔭 := ⟨Prime.ne_zero h𝔭₁⟩
  have : 𝔭.IsMaximal := (isPrime_of_prime h𝔭₁).isMaximal (NeZero.ne _)
  have h₁ : Nat.Coprime (Ideal.absNorm 𝔭) (2 * m) := by
    refine Nat.Coprime.of_dvd_left (map_dvd absNorm h𝔭₂) ?_
    exact coprime_absNorm_of_isCoprime_span (by exact_mod_cast hI')
  let p := (under ℤ 𝔭).absNorm
  have : Fact p.Prime := ⟨Nat.absNorm_under_prime 𝔭⟩
  have h₂ : p ∣ absNorm 𝔭 := Int.absNorm_under_dvd_absNorm 𝔭
  have : Fact (Odd p) :=
   ⟨Nat.coprime_two_right.mp <| (Nat.Coprime.of_dvd_left h₂ h₁).of_dvd_right (dvd_mul_right 2 m)⟩
  simp only [← pointwise_smul_def, Function.comp_apply, mapHom_apply,
    smul_pow', mem_isPrincipalSubmonoid_iff]
  exact Stickelberger₁ p k m 𝔭 <| (Nat.Coprime.of_dvd_left h₂ h₁).of_dvd_right (dvd_mul_left m 2)

end Stickelberger
